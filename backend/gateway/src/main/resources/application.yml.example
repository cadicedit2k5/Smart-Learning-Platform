spring:
  application:
    name: gateway

  http:
    clients:
      connect-timeout: 3s
      read-timeout: 60s

  cloud:
    gateway:
      server:
        webmvc:
          routes:

            # ===== SYSTEM SERVICE =====

            - id: system-auth-public
              uri: ${SYSTEM_SERVICE_URL:http://localhost:8081}
              predicates:
                - Path=/api/v1/auth/login,/api/v1/auth/register
                - Method=POST

            - id: system-admin
              uri: ${SYSTEM_SERVICE_URL:http://localhost:8081}
              predicates:
                - Path=/api/v1/admin/users,/api/v1/admin/users/**,/api/v1/admin/roles,/api/v1/admin/roles/**,/api/v1/admin/permissions,/api/v1/admin/permissions/**

            - id: system-auth
              uri: ${SYSTEM_SERVICE_URL:http://localhost:8081}
              predicates:
                - Path=/api/v1/auth/**

            - id: system-users
              uri: ${SYSTEM_SERVICE_URL:http://localhost:8081}
              predicates:
                - Path=/api/v1/users,/api/v1/users/**

            # ===== AI SERVICE =====

            - id: ai-conversations
              uri: ${AI_SERVICE_URL:http://localhost:8083}
              predicates:
                - Path=/api/v1/courses/*/ai/**

            # ===== CORE SERVICE =====

            - id: core-api
              uri: ${CORE_SERVICE_URL:http://localhost:8082}
              predicates:
                - Path=/api/v1/courses,/api/v1/courses/**,/api/v1/documents,/api/v1/documents/**,/api/v1/notifications,/api/v1/notifications/**,/api/v1/admin/courses,/api/v1/admin/courses/**,/api/v1/admin/documents,/api/v1/admin/documents/**

server:
  port: ${GATEWAY_PORT:8080}

management:
  endpoints:
    web:
      exposure:
        include: health,info

  endpoint:
    health:
      show-details: never

app:
  cors:
    allowed-origins: ${FRONTEND_URL:http://localhost:5173}